# Kinloop environment variables. Names only; copy to .env.local (never committed) and fill in.

# memory (local, tests) or firestore (production)
DATA_BACKEND=memory

# 32+ random bytes each (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
SESSION_SECRET=
LINK_SECRET=
# Shared secret sent by the GitHub Actions scheduler to POST /api/cron/tick
CRON_SECRET=

# Public base URL used in email links
APP_URL=http://localhost:3000

# Firebase service-account key JSON, base64-encoded (see docs/DEPLOY.md)
FIREBASE_SERVICE_ACCOUNT=

# Gemini API (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP with an app password
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
